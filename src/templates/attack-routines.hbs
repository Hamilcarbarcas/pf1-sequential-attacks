{{!-- Attack Routines: injected at the top of the PF1 combat tab. Mirrors actor-combat.hbs rows. --}}
<ol class="item-list seq-routines" data-list="seq-routines">
  <li class="item-list-header flexrow">
    <div class="item-name">
      <h3>{{localize "SEQ.Routine.Header"}}</h3>
    </div>
    <div class="item-detail item-attacks"><label>{{localize "PF1.Attacks"}}</label></div>
    <div class="item-detail item-damage"><label>{{localize "PF1.Damage"}}</label></div>
    <div class="item-detail item-range"><label>{{localize "PF1.Range"}}</label></div>
    <div class="item-detail item-actions"><i class="icon-pf icon-gears" data-tooltip="PF1.ActionPlural"></i></div>
    <div class="item-detail item-uses"><i class="icon-pf icon-battery-pack" data-tooltip="PF1.ChargePlural"></i></div>
    {{#if showUsage}}<div class="item-detail item-usage"><i class="icon-pf icon-hand" data-tooltip="PF1.Usage"></i></div>{{/if}}
    {{#if owner}}
    <div class="item-controls">
      <a class="item-control seq-routine-create" data-tooltip="SEQ.Routine.Create">
        <i class="fa-solid fa-plus" inert></i>
      </a>
    </div>
    {{/if}}
  </li>

  {{#each routines as |routine|}}
  {{!-- Routine row: the only row with a use button --}}
  <li class="item flexrow seq-routine seq-drop-target{{#if routine.collapsed}} seq-collapsed{{/if}}"
      data-routine-id="{{routine.id}}" draggable="true">
    <div class="item-name seq-routine-toggle">
      <i class="fa-solid fa-caret-down seq-routine-caret" inert></i>
      <div class="item-image" style='background-image: url("{{routine.img}}")'></div>
      <h4>{{routine.name}}</h4>
    </div>
    <div class="item-detail item-attacks"></div>
    <div class="item-detail item-damage"></div>
    <div class="item-detail item-range"></div>
    <div class="item-detail item-actions">
      <div class="item-action">
        {{#if routine.entries.length}}
        <a class="item-control seq-routine-use" data-tooltip="SEQ.Routine.Use">
          <i class="fa-solid fa-dice-d20" inert></i>
        </a>
        {{/if}}
      </div>
    </div>
    <div class="item-detail item-uses"></div>
    {{#if @root.showUsage}}<div class="item-detail item-usage"></div>{{/if}}
    {{#if @root.owner}}
    <div class="item-controls">
      <a class="item-control seq-routine-edit" data-tooltip="SEQ.Routine.Edit"><i class="fa-solid fa-edit" inert></i></a>
      <a class="item-control seq-routine-delete" data-tooltip="SEQ.Routine.Delete"><i class="fa-solid fa-trash" inert></i></a>
    </div>
    {{/if}}
  </li>

  {{!-- Entries: shortcuts to items on the actor, never items themselves --}}
  {{#each routine.entries as |entry|}}
  <li class="item flexrow seq-routine-child seq-routine-entry seq-drop-target{{#if entry.missing}} seq-missing{{/if}}"
      data-routine-id="{{routine.id}}" data-entry-id="{{entry.id}}"
      {{#if @root.owner}}draggable="true"{{/if}} {{#if routine.collapsed}}hidden{{/if}}>
    <div class="item-name">
      <div class="item-image" style='background-image: url("{{entry.img}}")'></div>
      <h4>{{entry.name}}{{#if entry.actionName}} <span class="seq-entry-action">({{entry.actionName}})</span>{{/if}}</h4>
    </div>
    <div class="item-detail item-attacks">
      {{#if entry.hasAttack}}<label>{{entry.attackSummary}}</label>{{/if}}
    </div>
    <div class="item-detail item-damage">
      {{#if entry.hasDamage}}<label class="resolved-formula">{{actionDamage entry.action}}</label>{{/if}}
    </div>
    <div class="item-detail item-range">
      {{#if entry.hasRange}}<label>{{actionRange entry.action null}}</label>{{/if}}
    </div>
    <div class="item-detail item-actions">
      <div class="item-action">
        {{#if @root.owner}}{{#unless entry.missing}}
        <a class="item-control seq-entry-preset{{#if entry.hasPreset}} seq-has-preset{{/if}}"
           data-tooltip="{{#if entry.hasPreset}}SEQ.Routine.EditPresetSet{{else}}SEQ.Routine.EditPreset{{/if}}">
          <i class="fa-solid fa-sliders-h" inert></i>
        </a>
        {{/unless}}{{/if}}
      </div>
    </div>
    <div class="item-detail item-uses flexrow">
      {{#if entry.isCharged}}
      <span class="value">{{entry.charges}}</span>
        {{#unless entry.noMaxCharges}}<span class="sep"> / </span><span class="max">{{entry.maxCharges}}</span>{{/unless}}
      {{else if entry.usesAmmo}}
      <span class="ammo-remaining">{{entry.ammoRemaining}}</span>
      {{/if}}
    </div>
    {{#if @root.showUsage}}<div class="item-detail item-usage">{{#if entry.activation}}<span>{{entry.activation}}</span>{{/if}}</div>{{/if}}
    {{#if @root.owner}}
    <div class="item-controls">
      {{#unless entry.missing}}
      <a class="item-control seq-entry-open" data-tooltip="PF1.EditItem"><i class="fa-solid fa-edit" inert></i></a>
      {{/unless}}
      <a class="item-control seq-entry-remove" data-tooltip="SEQ.Routine.Remove"><i class="fa-solid fa-link-slash" inert></i></a>
    </div>
    {{/if}}
  </li>
  {{else}}
  <li class="seq-routine-child seq-routine-empty seq-drop-target" data-routine-id="{{routine.id}}" {{#if routine.collapsed}}hidden{{/if}}>
    {{localize "SEQ.Routine.Empty"}}
  </li>
  {{/each}}
  {{/each}}
</ol>
