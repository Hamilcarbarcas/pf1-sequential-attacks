{{!-- Attack Routine sheet. Mirrors PF1's item sheet markup (templates/items/attack.hbs) so its styles apply. --}}
<form class="flexcol editable" autocomplete="off" data-tooltip-class="pf1">

  <header class="sheet-header flexrow">
    <img class="profile" src="{{img}}" data-tooltip="{{name}}" data-action="editImage">

    <div class="header-details flexrow">
      <h1 class="item-name">
        <input name="name" type="text" value="{{name}}" placeholder="{{localize "SEQ.Routine.NamePlaceholder"}}">
      </h1>
    </div>
  </header>

  <section class="sidebar">
    <header>
      <h3 class="item-type">{{localize "SEQ.Routine.SheetType"}}</h3>
      <h4 class="item-subtype">{{localize "SEQ.Routine.AttackCount" count=count}}</h4>
    </header>

    <label class="checkbox">
      <input type="checkbox" name="quickbar" {{checked quickbar}}> {{localize "SEQ.Routine.Quickbar"}}
    </label>
    <label class="checkbox">
      <input type="checkbox" name="quickRoll" {{checked quickRoll}}> {{localize "SEQ.Routine.QuickRoll"}}
    </label>
  </section>

  <nav class="sheet-navigation tabs" data-group="primary">
    <a class="item active" data-tab="description">{{localize "PF1.Description"}}</a>
  </nav>

  <section class="primary-body">
    <div class="tab description active" data-group="primary" data-tab="description">
      <prose-mirror name="description" value="{{description}}" toggled>{{{enrichedDescription}}}</prose-mirror>
    </div>
  </section>
</form>
